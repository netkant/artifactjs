{
  "name": "@urlund/artifactjs",
  "version": "0.3.2",
  "description": "A lightweight shared-state library for React 19. Define data once, use it anywhere.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "benchmark": "npm run benchmark:micro && npm run benchmark:react",
    "benchmark:micro": "tsx benchmarks/micro.ts",
    "benchmark:react": "tsx benchmarks/react-render.tsx",
    "prepublishOnly": "npm run build",
    "publish": "npm publish --access public"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jotai": "^2.20.3",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "react",
    "state",
    "shared-state",
    "suspense",
    "hooks",
    "atomic",
    "jotai-alternative",
    "localstorage"
  ],
  "author": "Henrik Urlund <henrik@urlund.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urlund/artifactjs.git"
  },
  "homepage": "https://github.com/urlund/artifactjs#readme",
  "bugs": {
    "url": "https://github.com/urlund/artifactjs/issues"
  }
}
